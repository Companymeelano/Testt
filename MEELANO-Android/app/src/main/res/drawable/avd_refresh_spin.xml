<?xml version="1.0" encoding="utf-8"?>
<!-- Phase-7E: a refresh arrow that spins while a connection check runs. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="rot"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="arc"
                    android:pathData="M12,4.5 A7.5,7.5 0 1 1 4.5,12"
                    android:strokeColor="#FFE7B15A"
                    android:strokeWidth="2.4"
                    android:strokeLineCap="round"
                    android:fillColor="#00000000" />
                <path
                    android:name="head"
                    android:pathData="M12,1.6 L12,7.4 L8.6,4.5 Z"
                    android:fillColor="#FFE7B15A" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="rot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="900"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="infinite"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
</animated-vector>
